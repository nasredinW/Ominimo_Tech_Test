{
    "dataflows": [
        {
            "name": "motor-ingestion",
            "sinks": [
                {
                    "format": "JSON",
                    "input": "add_ingestion_date",
                    "name": "raw-ok",
                    "paths": [
                        "data/output/events/motor_policy"
                    ],
                    "saveMode": "OVERWRITE"
                },
                {
                    "format": "JSON",
                    "input": "validation_ko",
                    "name": "raw-ko",
                    "paths": [
                        "data/output/discards/motor_policy"
                    ],
                    "saveMode": "OVERWRITE"
                }
            ],
            "sources": [
                {
                    "format": "JSON",
                    "name": "policy_inputs",
                    "path": "data/input.json"
                }
            ],
            "transformations": [
                {
                    "name": "validation",
                    "params": {
                        "input": "policy_inputs",
                        "validations": [
                            {
                                "field": "plate_number",
                                "validations": [
                                    "notEmpty"
                                ]
                            },
                            {
                                "field": "driver_age",
                                "validations": [
                                    "notNull"
                                ]
                            }
                        ]
                    },
                    "type": "validate_fields"
                },
                {
                    "name": "add_ingestion_date",
                    "params": {
                        "addFields": [
                            {
                                "function": "current_timestamp",
                                "name": "ingestion_dt"
                            }
                        ],
                        "input": "validation_ok"
                    },
                    "type": "add_fields"
                }
            ]
        }
    ]
}